diff --git a/watchpoint.h b/watchpoint.h
new file mode 100644
index 0000000..a2b6272
--- /dev/null
+++ b/watchpoint.h
@@ -0,0 +1,224 @@
+/* Reverse-engineering aid, not part of upstream Snes9x.
+ *
+ * Logs the program counter whenever a watched WRAM location is written, which
+ * is the headless equivalent of a debugger write-breakpoint.
+ *
+ * Configure with environment variables:
+ *   S9X_WATCH_WRITE  comma-separated hex addresses. Either a bare WRAM offset
+ *                    ("0088", "1C700") or a bank-qualified address ("7E0088").
+ *   S9X_WATCH_LIMIT  maximum number of hits to log (default 200).
+ *   S9X_WATCH_WRANGE comma-separated ranges of WRAM offsets to log all writes
+ *                    to, e.g. "0000-01FF". Diffing two runs' logs finds a
+ *                    value that differs between them.
+ *   S9X_WATCH_READ   comma-separated ranges of full addresses to log reads of,
+ *                    e.g. "81A1A9-81A1FF". Useful for catching a table lookup:
+ *                    the read address minus the table base gives the index.
+ *
+ * WRAM is mirrored, so a write to $00:0088 and one to $7E:0088 reach the same
+ * byte. Matching is done on the resolved WRAM offset rather than the raw
+ * address, because games normally use the low-RAM mirror.
+ */
+
+#ifndef _WATCHPOINT_H_
+#define _WATCHPOINT_H_
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define S9X_WATCH_MAX 8
+
+static inline int s9x_wram_offset (unsigned int address)
+{
+	unsigned int bank = (address >> 16) & 0xFF;
+	unsigned int off  = address & 0xFFFF;
+
+	if (bank == 0x7E)
+		return (int) off;
+	if (bank == 0x7F)
+		return (int) (0x10000 + off);
+	if ((bank <= 0x3F || (bank >= 0x80 && bank <= 0xBF)) && off < 0x2000)
+		return (int) off;
+	return -1;
+}
+
+static inline void s9x_watch_write (unsigned int address, unsigned int value,
+                                    int size, unsigned int pbpc)
+{
+	static int  inited = 0;
+	static int  list[S9X_WATCH_MAX];
+	static int  count = 0;
+	static long budget = 0;
+
+	if (!inited)
+	{
+		const char *spec, *lim;
+		inited = 1;
+		spec = getenv("S9X_WATCH_WRITE");
+		lim  = getenv("S9X_WATCH_LIMIT");
+		budget = lim ? strtol(lim, NULL, 0) : 200;
+		if (spec)
+		{
+			char  buf[256];
+			char *tok;
+			strncpy(buf, spec, sizeof(buf) - 1);
+			buf[sizeof(buf) - 1] = 0;
+			tok = strtok(buf, ",");
+			while (tok && count < S9X_WATCH_MAX)
+			{
+				unsigned int a = (unsigned int) strtoul(tok, NULL, 16);
+				int off = (a > 0xFFFF) ? s9x_wram_offset(a) : (int) a;
+				if (off >= 0)
+					list[count++] = off;
+				tok = strtok(NULL, ",");
+			}
+		}
+	}
+
+	if (count == 0 || budget <= 0)
+		return;
+
+	{
+		int off = s9x_wram_offset(address);
+		int i;
+		if (off < 0)
+			return;
+		for (i = 0; i < count; i++)
+		{
+			if (off == list[i] || (size == 2 && off + 1 == list[i]))
+			{
+				fprintf(stderr,
+				        "[watch] write $%06X (wram $%05X) = %0*X  PC $%02X:%04X  "
+				        "A=%04X X=%04X Y=%04X D=%04X DB=%02X\n",
+				        address & 0xFFFFFF, off, size * 2, value,
+				        (pbpc >> 16) & 0xFF, pbpc & 0xFFFF,
+				        Registers.A.W, Registers.X.W, Registers.Y.W,
+				        Registers.D.W, Registers.DB);
+				fflush(stderr);
+				budget--;
+				break;
+			}
+		}
+	}
+}
+
+
+static inline void s9x_watch_wrange (unsigned int address, unsigned int value,
+                                     int size, unsigned int pbpc)
+{
+	static int          inited = 0;
+	static unsigned int lo[8], hi[8];
+	static int          count = 0;
+	static long         budget = 0;
+
+	if (!inited)
+	{
+		const char *spec, *lim;
+		inited = 1;
+		spec = getenv("S9X_WATCH_WRANGE");
+		lim  = getenv("S9X_WATCH_LIMIT");
+		budget = lim ? strtol(lim, NULL, 0) : 200;
+		if (spec)
+		{
+			char  buf[256];
+			char *tok;
+			strncpy(buf, spec, sizeof(buf) - 1);
+			buf[sizeof(buf) - 1] = 0;
+			tok = strtok(buf, ",");
+			while (tok && count < 8)
+			{
+				char *dash = strchr(tok, '-');
+				lo[count] = (unsigned int) strtoul(tok, NULL, 16);
+				hi[count] = dash ? (unsigned int) strtoul(dash + 1, NULL, 16) : lo[count];
+				count++;
+				tok = strtok(NULL, ",");
+			}
+		}
+	}
+
+	if (count == 0 || budget <= 0)
+		return;
+
+	{
+		int off = s9x_wram_offset(address);
+		int i;
+		if (off < 0)
+			return;
+		for (i = 0; i < count; i++)
+		{
+			if ((unsigned int) off >= lo[i] && (unsigned int) off <= hi[i])
+			{
+				fprintf(stderr, "[wrange] $%05X = %0*X  PC $%02X:%04X\n",
+				        off, size * 2, value,
+				        (pbpc >> 16) & 0xFF, pbpc & 0xFFFF);
+				fflush(stderr);
+				budget--;
+				break;
+			}
+		}
+	}
+}
+
+#define S9X_WATCH_RANGES 8
+
+static inline void s9x_watch_read (unsigned int address, int size,
+                                   unsigned int pbpc)
+{
+	static int          inited = 0;
+	static unsigned int lo[S9X_WATCH_RANGES], hi[S9X_WATCH_RANGES];
+	static int          count = 0;
+	static long         budget = 0;
+
+	if (!inited)
+	{
+		const char *spec, *lim;
+		inited = 1;
+		spec = getenv("S9X_WATCH_READ");
+		lim  = getenv("S9X_WATCH_LIMIT");
+		budget = lim ? strtol(lim, NULL, 0) : 200;
+		if (spec)
+		{
+			char  buf[256];
+			char *tok;
+			strncpy(buf, spec, sizeof(buf) - 1);
+			buf[sizeof(buf) - 1] = 0;
+			tok = strtok(buf, ",");
+			while (tok && count < S9X_WATCH_RANGES)
+			{
+				char *dash = strchr(tok, '-');
+				unsigned int a = (unsigned int) strtoul(tok, NULL, 16);
+				unsigned int b = dash ? (unsigned int) strtoul(dash + 1, NULL, 16) : a;
+				lo[count] = a;
+				hi[count] = b;
+				count++;
+				tok = strtok(NULL, ",");
+			}
+		}
+	}
+
+	if (count == 0 || budget <= 0)
+		return;
+
+	{
+		unsigned int a = address & 0xFFFFFF;
+		int i;
+		for (i = 0; i < count; i++)
+		{
+			if (a >= lo[i] && a <= hi[i])
+			{
+				fprintf(stderr,
+				        "[watch] read  $%06X (+%04X) size %d  PC $%02X:%04X  "
+				        "A=%04X X=%04X Y=%04X D=%04X DB=%02X\n",
+				        a, a - lo[i], size,
+				        (pbpc >> 16) & 0xFF, pbpc & 0xFFFF,
+				        Registers.A.W, Registers.X.W, Registers.Y.W,
+				        Registers.D.W, Registers.DB);
+				fflush(stderr);
+				budget--;
+				break;
+			}
+		}
+	}
+}
+
+#endif
